# GenLayer RPC API URL
# Default: https://studio.genlayer.com/api
# Use this default for the hosted Studio, or your own GenLayer node URL for local development.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# GenLayer Network Configuration
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# JusticeUpgrade v2 Intelligent Contract address
# Live v2 deployment on GenLayer studionet (deployed code sha256 matches
# contracts/justice_upgrade.py). Replace with your own address to point the UI
# at another deployment; leave empty to see the "set the address" state.
NEXT_PUBLIC_JUSTICE_CONTRACT_ADDRESS=0x3c1c2202bD4c092616FFDBCFe7981c4299199E01

# Legacy / fallback variable (v1). Only used if the v2 variable above is unset.
# Leave empty unless you are pointing the UI at an older deployment.
NEXT_PUBLIC_CONTRACT_ADDRESS=
